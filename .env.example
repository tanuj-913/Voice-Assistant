# --- Speech recognition -----------------------------------------------------
# 'auto' uses on-device whisper when the model is present, else Sarvam.
# Local whisper needs no key and no audio ever leaves this machine.
STT_PROVIDER=auto
WHISPER_MODEL_PATH=./models/ggml-small.bin
WHISPER_BINARY=whisper-cli
# A resident whisper-server saves ~165ms per spoken turn (measured: cli
# median 789ms, server median 626ms) and absorbs the Metal shader compile at
# start-up rather than paying ~2s on the first utterance after a cold cache.
# Set WHISPER_SERVER_ENABLED=false to go back to the CLI.
WHISPER_SERVER_URL=http://127.0.0.1:4319
WHISPER_SERVER_ENABLED=true
# Small model for live partial transcripts while you speak.
WHISPER_FAST_MODEL_PATH=./models/ggml-base.bin

# --- Sarvam (optional: better Indian-language voices) -----------------------
# Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# --- Local LLM --------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b-a3b
# How long to keep the model in memory (~19GB while loaded).
# '30m' keeps it warm during a session; '-1' pins it forever; '0' frees it immediately.
OLLAMA_KEEP_ALIVE=-1

# --- Web search -------------------------------------------------------------
# Serper gives Google results: 2,500 free queries, no card. https://serper.dev
# Without it, search falls back to scraping DuckDuckGo, which is throttled.
SERPER_API_KEY=
# Region/language for results. 'in' + 'en' = Indian English results.
SEARCH_REGION=in
SEARCH_LANGUAGE=en

# Cloud fallback. OFF by default, and both of these are required to turn it on.
#
# What it buys: an unrouted turn spends 5-8s generating on this Mac. A hosted
# model answers in well under a second, which is the only route to the PRD's
# 3-second target for arbitrary questions.
#
# What it costs: those turns leave your machine. The fast path still answers
# common commands locally, and `offlineFirst` in settings overrides this
# entirely. Get a key free, no card, at https://aistudio.google.com/apikey
CLOUD_FALLBACK=false
GEMINI_API_KEY=
# Free tier covers Flash and Flash-Lite only. The brain checks at boot that
# this model is actually available to your key and names the alternatives if
# it is not.
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Local ------------------------------------------------------------------
BRAIN_PORT=4317
DATABASE_URL=postgres://localhost:5432/assistant
LOG_LEVEL=info

# --- Speech cache -----------------------------------------------------------
# Pre-synthesise the sentences Assistant says most often ("Paused.", "Opened
# Safari.", "Volume set to 40 percent.") in the background just after boot, so
# the first person to trigger one does not pay Sarvam's ~950ms round trip plus
# a conversion. Pauses whenever a real turn is in flight, so it can never take
# the converter's slot from someone waiting for an answer. Turn it off for a
# completely quiet boot, or when there is no Sarvam key to warm against.
PHRASE_CACHE_WARM=true

# --- Voice conversion (the trained voice) -----------------------------------
# Speaks in the trained voice instead of the pitch-shifted one. Needs
# `voice-training/rvc_server.py` running; if it is not, Assistant falls back to
# the pitch shift rather than going quiet.
RVC_ENABLED=false
RVC_BASE_URL=http://127.0.0.1:4318
# How hard the faiss index pulls toward the training voice, 0 to 1.
RVC_INDEX_RATE=0.5

# --- Multi-step planning ----------------------------------------------------
# Ask the model for a plan before acting on requests that look like more than
# one action. Off by default: a planning pass is a whole extra generation, and
# at ~31 tok/s that is seconds before anything happens. Turn it on once the
# model is fast enough.
PLANNER_ENABLED=false

# --- Slack ------------------------------------------------------------------
# Unlike Mail, Slack has no AppleScript route, so this is the only way in.
# Posting needs chat:write and channels:read. Searching additionally needs a
# user token with search:read. Without it the Slack tools explain themselves
# rather than disappearing.
SLACK_TOKEN=

# --- Personality and notifications ------------------------------------------
# Whether Assistant may interrupt you with a notification without being asked.
# Off by default: an assistant that can interrupt unprompted is a different
# product from one that answers when asked.
PROACTIVE_NOTIFICATIONS=false
# How Assistant talks. The spoken-output rules are not configurable — a persona
# cannot turn replies back into markdown.
# ASSISTANT_PERSONALITY=Warm and direct. Answer in one or two spoken sentences.

# Wake word. Comma separated — include the spellings whisper produces, not
# just the correct one. Defaults to "assistant" and its common misrenderings.
WAKE_WORD_VARIANTS=assistant,asistant,assistent,assistante,sistant
