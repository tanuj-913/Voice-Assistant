{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Assistant",
  "version": "0.1.0",
  "identifier": "dev.tanuj.voiceassistant",
  "build": {
    "frontendDist": "../../face/dist",
    "devUrl": "http://127.0.0.1:5273",
    "beforeDevCommand": "pnpm --filter @assistant/face dev",
    "beforeBuildCommand": "pnpm --filter @assistant/face build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Voice Assistant",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4317 http://localhost:4317 ws://127.0.0.1:5273; media-src 'self' http://127.0.0.1:4317 http://localhost:4317 blob: data:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; worker-src 'self' blob:"
    },
    "trayIcon": {
      "id": "assistant-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "Assistant"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {}
}
